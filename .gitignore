# MicroFileManager — .gitignore

# Live config — contains real user credentials and paths. NEVER commit this.
config.php

# Apache virtual host config — contains server-specific paths
mfm.conf

# Runtime session storage — files are ephemeral, never commit.
mfm_sessions/

# Atomic write temp file — auto-cleaned, but ignored as a safety net.
config.php.tmp

# Local project context — contains personal paths and deployment notes.
PROJECT_CONTEXT.md

# Wiki repo — cloned separately, has its own .git
wiki/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Offline asset cache — populated by download_assets.py, not tracked in git.
# Users/deployments run the script themselves to get offline support.
mfm-assets/

# Editor metadata
.vscode/
.idea/
*.swp
*.swo
